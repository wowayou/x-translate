{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XTranslate glossary resource interchange v2",
  "description": "Data only. Adds user-supplied provenance and an optional revision to the v1 glossary fields. No credentials, application configuration, or verified permission. The application also enforces UTF-16, language, duplicate/conflict, UTC, and total-content limits. References resolve to the adjacent v1 schema; validation needs no network.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "name", "domain", "sourceLanguage", "targetLanguage", "matching", "terms", "provenance", "revision"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "xtranslate.glossary" },
    "name": { "$ref": "glossary.schema.json#/properties/name" },
    "domain": { "$ref": "glossary.schema.json#/properties/domain" },
    "sourceLanguage": { "$ref": "glossary.schema.json#/properties/sourceLanguage" },
    "targetLanguage": { "$ref": "glossary.schema.json#/properties/targetLanguage" },
    "matching": { "$ref": "glossary.schema.json#/properties/matching" },
    "terms": { "$ref": "glossary.schema.json#/properties/terms" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceName", "sourceUri", "license", "licenseUri", "attribution", "sourceVersion"],
      "properties": {
        "sourceName": { "type": "string", "maxLength": 256 },
        "sourceUri": { "type": "string", "maxLength": 2048 },
        "license": { "type": "string", "maxLength": 256, "description": "Empty means unknown, not unrestricted use." },
        "licenseUri": { "type": "string", "maxLength": 2048 },
        "attribution": { "type": "string", "maxLength": 4096 },
        "sourceVersion": { "type": "string", "maxLength": 120 }
      }
    },
    "revision": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resourceId", "number", "createdUtc", "sourceSha256", "changeNote"],
          "properties": {
            "resourceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
            "number": { "type": "integer", "minimum": 1, "maximum": 1000000 },
            "createdUtc": { "type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$" },
            "sourceSha256": { "type": "string", "pattern": "^([0-9a-f]{64})?$", "description": "Captured source bytes or empty if not supplied. Not a certificate of authenticity." },
            "changeNote": { "type": "string", "maxLength": 2048 }
          }
        }
      ]
    }
  }
}
