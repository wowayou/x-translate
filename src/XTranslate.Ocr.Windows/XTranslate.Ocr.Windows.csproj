<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CsWinRTWindowsMetadata>"$(PkgMicrosoft_Windows_SDK_NET_Ref)\winmd"</CsWinRTWindowsMetadata>
    <!-- Generate only the self-contained OCR/bitmap/language/async type closure. No full SDK projection or embedded runtime. -->
    <CsWinRTIncludes>Windows.Media.Ocr;Windows.Globalization.ILanguage;Windows.Globalization.Language;Windows.Graphics.Imaging.ISoftwareBitmap;Windows.Graphics.Imaging.SoftwareBitmap;Windows.Graphics.Imaging.BitmapPixelFormat;Windows.Graphics.Imaging.BitmapAlphaMode;Windows.Graphics.Imaging.BitmapBuffer;Windows.Graphics.Imaging.IBitmapBuffer;Windows.Graphics.Imaging.BitmapPlaneDescription;Windows.Graphics.Imaging.BitmapBufferAccessMode;Windows.Graphics.DirectX.Direct3D11.IDirect3DSurface;Windows.Graphics.DirectX.Direct3D11.Direct3DSurfaceDescription;Windows.Graphics.DirectX.Direct3D11.Direct3DMultisampleDescription;Windows.Graphics.DirectX.DirectXPixelFormat;Windows.Storage.Streams.IBuffer;Windows.Storage.Streams.Buffer;Windows.Storage.Streams.DataWriter;Windows.Storage.Streams.IDataWriter;Windows.Storage.Streams.UnicodeEncoding;Windows.Storage.Streams.ByteOrder;Windows.Storage.Streams.IOutputStream;Windows.Foundation.IMemoryBuffer;Windows.Foundation.MemoryBuffer;Windows.Foundation.Async;Windows.Foundation.IAsync;Windows.Foundation.TypedEventHandler;Windows.Foundation.Collections;Windows.Foundation.Metadata;Windows.Foundation.FoundationContract;Windows.Foundation.UniversalApiContract</CsWinRTIncludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../XTranslate.Core/XTranslate.Core.csproj" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" PrivateAssets="build;buildTransitive;analyzers" />
    <PackageReference Include="Microsoft.Windows.SDK.NET.Ref" Version="10.0.19041.57" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <None Include="../XTranslate.App/ThirdParty/CsWinRT-LICENSE.txt" Link="ThirdParty/CsWinRT-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
