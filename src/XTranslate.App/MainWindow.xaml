<Window x:Class="XTranslate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XTranslate.App"
        Title="XTranslate" Style="{StaticResource {x:Type Window}}" Width="620" Height="660" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
  <Grid x:Name="ViewportFrame" Margin="18,12,18,14">
  <ScrollViewer x:Name="WindowViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                CanContentScroll="False" Focusable="False">
  <Grid x:Name="MainLayout" MinHeight="660" Height="{Binding ActualHeight, ElementName=ViewportFrame}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="1.12*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image x:Name="AppIconImage" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel>
          <TextBlock x:Name="TitleText" Text="XTranslate" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="TaglineText" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="OcrButton" Tag="&#xE7F4;" Style="{StaticResource IconAction}" Margin="0,0,6,0"
                Click="Ocr_Click" AutomationProperties.AutomationId="OpenOcr"/>
        <Button x:Name="LearningButton" Tag="&#xE82D;" Style="{StaticResource IconAction}" Margin="0,0,6,0"
                Click="Learning_Click" AutomationProperties.AutomationId="LearningNotebook"/>
        <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggle}" Margin="0,0,6,0"
                      Checked="Pin_Changed" Unchecked="Pin_Changed" AutomationProperties.AutomationId="PinButton">
          <TextBlock x:Name="PinGlyph" Text="&#xE718;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="16">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsChecked, ElementName=PinButton}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Background.Color, ElementName=PinButton, Converter={StaticResource AccentForeground}}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </ToggleButton>
        <Button x:Name="SettingsButton" Content="设置" Tag="&#xE713;" Style="{StaticResource IconAction}"
                Click="Settings_Click" AutomationProperties.AutomationId="SettingsButton"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1">
      <Border x:Name="InfoBar" Visibility="Collapsed" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12"
              AutomationProperties.AutomationId="InfoBar">
        <DockPanel>
          <Button x:Name="InfoBarCloseButton" DockPanel.Dock="Right" Content="关闭" Tag="&#xE711;" Style="{StaticResource IconAction}"
                  Margin="6,0,0,0" Click="InfoBarClose_Click" AutomationProperties.AutomationId="InfoBarClose"/>
          <Button x:Name="InfoBarActionButton" DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0" Click="InfoBarAction_Click"
                  AutomationProperties.AutomationId="InfoBarAction"/>
          <TextBlock x:Name="InfoBarText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
      </Border>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="152"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="ProviderLabel" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5"/>
          <ComboBox x:Name="ProviderBox" SelectionChanged="Selection_Changed" MaxDropDownHeight="320"
                    ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"
                    AutomationProperties.LabeledBy="{Binding ElementName=ProviderLabel}" AutomationProperties.AutomationId="ProviderBox">
            <ComboBoxItem x:Name="ProviderGoogleItem" Tag="GoogleWeb"/><ComboBoxItem x:Name="ProviderDeepLItem" Tag="DeepL"/>
            <ComboBoxItem x:Name="ProviderMicrosoftItem" Tag="MicrosoftTranslator" IsEnabled="False"/>
            <ComboBoxItem x:Name="ProviderPapagoItem" Tag="Papago" IsEnabled="False"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock x:Name="TargetLabel" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5"/>
          <ComboBox x:Name="LanguageBox" SelectionChanged="Selection_Changed" MaxDropDownHeight="320"
                    ToolTip="{Binding SelectedItem.Content, RelativeSource={RelativeSource Self}}"
                    AutomationProperties.LabeledBy="{Binding ElementName=TargetLabel}" AutomationProperties.AutomationId="LanguageBox"/>
        </StackPanel>
      </Grid>
      <CheckBox x:Name="ReviewSourceBox" Margin="0,0,0,6" Checked="ReviewSource_Changed" Unchecked="ReviewSource_Changed"
                AutomationProperties.AutomationId="ReviewSourceBox"/>
      <TextBlock x:Name="SourceReviewHelp" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </StackPanel>

    <Border x:Name="SourceCard" Grid.Row="2">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SourceBox}" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,-5,-5,0">
            <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
            <Button x:Name="CollectLearningButton" Tag="&#xE734;" Style="{StaticResource IconAction}" Click="CollectLearning_Click" AutomationProperties.AutomationId="CollectLearning"/>
            <Button x:Name="PasteButton" Content="粘贴" Tag="&#xE77F;" Style="{StaticResource IconAction}" Click="Paste_Click" AutomationProperties.AutomationId="PasteButton"/>
            <Button x:Name="ClearButton" Content="清空" Tag="&#xE894;" Style="{StaticResource IconAction}" Click="Clear_Click" AutomationProperties.AutomationId="ClearButton"/>
          </StackPanel>
          <TextBlock x:Name="SourceLabel" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="SourceBox" Grid.Row="1" Style="{StaticResource TranslationEditor}" TextChanged="Source_Changed"
                 AutomationProperties.LabeledBy="{Binding ElementName=SourceLabel}" AutomationProperties.AutomationId="SourceText"/>
        <TextBlock x:Name="SourcePlaceholder" Grid.Row="1" IsHitTestVisible="False" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SourceBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="TranslateButton" Content="翻译 Ctrl+Enter" Style="{StaticResource PrimaryAction}" Click="Translate_Click" AutomationProperties.AutomationId="TranslateButton"/>
      <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Click="Cancel_Click" Visibility="Collapsed" AutomationProperties.AutomationId="CancelButton"/>
      <TextBlock x:Name="RequestHint" Grid.Column="2" Margin="12,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
    </Grid>

    <Border x:Name="ResultCard" Grid.Row="4" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6">
          <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="复制译文" Tag="&#xE8C8;" Style="{StaticResource IconAction}"
                  Margin="0,-5,-5,0" Click="Copy_Click" IsEnabled="False" AutomationProperties.AutomationId="CopyButton"/>
          <TextBlock x:Name="ResultLabel" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
          <TextBlock x:Name="SourceReviewSummary" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="SourceReviewSummary"
                     AutomationProperties.LiveSetting="Polite"/>
          <Expander x:Name="ReviewDetails" Visibility="Collapsed" Margin="0,6,0,0" AutomationProperties.AutomationId="ReviewDetails">
            <local:TranslationOutput x:Name="SourceReviewText" Height="170" Style="{StaticResource TranslationOutputStyle}"
                     IsReadOnly="True" IsUndoEnabled="False" InputMethod.IsInputMethodEnabled="False"
                     AutomationProperties.AutomationId="SourceReviewDetails"/>
          </Expander>
        </StackPanel>
        <!-- Display/selection only. Plain Run updates avoid TextBox.Text's synchronous TSF selection resets. -->
        <local:TranslationOutput x:Name="ResultBox" Grid.Row="2" Style="{StaticResource TranslationOutputStyle}" IsReadOnly="True" IsUndoEnabled="False"
                 InputMethod.IsInputMethodEnabled="False"
                 AutomationProperties.LabeledBy="{Binding ElementName=ResultLabel}" AutomationProperties.AutomationId="ResultText"/>
        <TextBlock x:Name="ResultPlaceholder" Grid.Row="2" IsHitTestVisible="False" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ResultBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock x:Name="ProvenanceLabel" Grid.Row="3" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,10,0,0"/>
      </Grid>
    </Border>

    <StackPanel Grid.Row="5" Margin="0,10,0,0">
      <DockPanel>
        <Button x:Name="StatusActionButton" DockPanel.Dock="Right" Visibility="Collapsed" Padding="10,4" Margin="10,0,0,0" FontSize="12"
                VerticalAlignment="Top" Click="StatusAction_Click" AutomationProperties.AutomationId="StatusAction"/>
        <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                   AutomationProperties.AutomationId="StatusText" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
      <TextBlock x:Name="DiagnosticLabel" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RequestDiagnostics"/>
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock x:Name="HotkeyLabel" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          <TextBlock x:Name="TrayFooterLabel" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="UiLanguageLabel" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
          <ComboBox x:Name="UiLanguageBox" Width="118" FontSize="12" SelectionChanged="UiLanguage_Changed"
                    AutomationProperties.LabeledBy="{Binding ElementName=UiLanguageLabel}" AutomationProperties.AutomationId="UiLanguageBox">
            <ComboBoxItem x:Name="UiAutoItem"/><ComboBoxItem x:Name="UiChineseItem"/><ComboBoxItem x:Name="UiEnglishItem"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
  </ScrollViewer>
  </Grid>
</Window>
