<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>XTranslate</AssemblyName>
    <RootNamespace>XTranslate.App</RootNamespace>
    <Version>0.4.0</Version>
    <!-- Set by build.ps1 / install.ps1. "Dev" builds (bin/) never self-update. -->
    <UpdateFlavor Condition="'$(UpdateFlavor)' == ''">Dev</UpdateFlavor>
    <ApplicationIcon>Assets\xtranslate.ico</ApplicationIcon>
    <!-- WPF owns the UI/DPI manifest; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
    <!-- The UI ships its own zh/en strings; framework satellites for other cultures are unused weight. -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UpdateFlavor" Value="$(UpdateFlavor)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../XTranslate.Core/XTranslate.Core.csproj" />
    <ProjectReference Include="../XTranslate.Diagnostics/XTranslate.Diagnostics.csproj" />
    <ProjectReference Include="../XTranslate.Ocr.Windows/XTranslate.Ocr.Windows.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <Resource Include="Assets\xtranslate.png" />
    <EmbeddedResource Include="Assets\xtranslate.ico" />
  </ItemGroup>
</Project>
