<Window x:Class="XTranslate.App.MouseSelectionIcon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Width="36" Height="36" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" Topmost="True" WindowStartupLocation="Manual">
  <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
    <Button x:Name="OpenButton" Tag="&#xE8A7;" Style="{StaticResource IconAction}" Focusable="False"
            Click="Open_Click" AutomationProperties.AutomationId="MouseSelectionOpen"/>
  </Border>
</Window>
