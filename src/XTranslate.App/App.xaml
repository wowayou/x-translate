<Application x:Class="XTranslate.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#182B34" />
    <SolidColorBrush x:Key="Muted" Color="#566971" />
    <SolidColorBrush x:Key="Accent" Color="#17695E" />
    <SolidColorBrush x:Key="Danger" Color="#A6372B" />
    <!-- Design tokens: see docs/DESIGN-SYSTEM.md. Text colors meet WCAG AA on Canvas and Surface. -->
    <SolidColorBrush x:Key="Canvas" Color="#F5F7F6" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceTint" Color="#EDF5F1" />
    <SolidColorBrush x:Key="SurfaceTintBorder" Color="#CFE1D8" />
    <SolidColorBrush x:Key="Border" Color="#CBD6D2" />
    <SolidColorBrush x:Key="Divider" Color="#D7E0DC" />
    <SolidColorBrush x:Key="Focus" Color="#2A9686" />
    <SolidColorBrush x:Key="Selection" Color="#8DCABB" />
    <SolidColorBrush x:Key="NavHover" Color="#E6EEEB" />
    <SolidColorBrush x:Key="NavSelected" Color="#DDEBE6" />
    <SolidColorBrush x:Key="InfoSurface" Color="#E7F3EF" />
    <Style x:Key="NavTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid x:Name="Root" Background="Transparent" MinWidth="148" Margin="0,0,0,2">
              <Border x:Name="Fill" CornerRadius="6" Background="Transparent" BorderThickness="2" BorderBrush="Transparent" />
              <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,8" CornerRadius="2" Background="Transparent" />
              <ContentPresenter x:Name="Label" ContentSource="Header" Margin="14,9,12,9" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="{StaticResource NavHover}" /></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Fill" Property="Background" Value="{StaticResource NavSelected}" />
                <Setter TargetName="Marker" Property="Background" Value="{StaticResource Accent}" />
                <!-- Only the label: a TabItem's FontWeight would be inherited by the whole page. -->
                <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Fill" Property="BorderBrush" Value="{StaticResource Focus}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="{StaticResource Canvas}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Focus}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="SelectionBrush" Value="{StaticResource Selection}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Application.Resources>
</Application>
