<Window x:Class="XTranslate.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XTranslate 设置" Style="{StaticResource {x:Type Window}}" Width="570" Height="760" MinHeight="520" MinWidth="500" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock x:Name="ErrorLabel" Foreground="#B2452A" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="取消" IsCancel="True"/><Button x:Name="SaveButton" Content="保存" IsDefault="True" Click="Save_Click" Background="{StaticResource Accent}" Foreground="White" Margin="0"/>
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock x:Name="IntroText" Text="把翻译方式交给你" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <TextBlock x:Name="UiLanguageLabel" Text="界面语言" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <ComboBox x:Name="UiLanguageBox" Margin="0,0,0,18" SelectionChanged="UiLanguage_Changed" AutomationProperties.AutomationId="SettingsUiLanguageBox">
          <ComboBoxItem x:Name="UiAutoItem"/><ComboBoxItem x:Name="UiChineseItem"/><ComboBoxItem x:Name="UiEnglishItem"/>
        </ComboBox>
        <Separator Margin="0,0,0,18"/>
        <TextBlock x:Name="ShortcutsHeader" Text="快捷键与取词" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <CheckBox x:Name="AltHotkeyBox" Content="使用 Ctrl+Alt+Q（避免 Ctrl+Q 与其他应用冲突）" Margin="0,0,0,12"/>
        <CheckBox x:Name="AutoTranslateBox" Content="快捷键取词后，自动发送给当前所选服务翻译" Margin="0,0,0,12"/>
        <CheckBox x:Name="AutoHideBox" Content="取词弹窗失去焦点时自动收起" Margin="0,0,0,12"/>
        <CheckBox x:Name="CopyCaptureBox" Content="启用兼容取词（必要时模拟 Ctrl+C）" Margin="0,0,0,8"/>
        <TextBlock x:Name="CaptureHelp" Text="优先读取应用选区。兼容取词会短暂使用剪贴板并尝试恢复；图片、文件等无法安全备份的内容会阻止该路径。终端不模拟 Ctrl+C。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18"/>
        <Separator Margin="0,0,0,18"/>
        <TextBlock x:Name="GoogleTitle" Text="Google 网页翻译" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock x:Name="GoogleHelp" Text="无需密钥。使用非官方网页接口，可能限流或无法连接；需要网络能访问 Google。原文会发送到 Google。失败后由你重试或更换服务。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18"/>
        <TextBlock x:Name="DeepLTitle" Text="DeepL 官方 API" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock x:Name="DeepLKeyLabel" Text="API 密钥" Margin="0,0,0,4"/><PasswordBox x:Name="DeepLKeyBox" Padding="9" Margin="0,0,0,8"/>
        <CheckBox x:Name="DeepLProBox" Content="使用 DeepL API Pro（默认 API Free）" Margin="0,0,0,18"/>
        <TextBlock x:Name="OpenAiTitle" Text="OpenAI 兼容服务" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock x:Name="EndpointLabel" Text="完整 Chat Completions 地址（HTTPS）" Margin="0,0,0,4"/>
        <TextBox x:Name="EndpointBox" Margin="0,0,0,8" ToolTip="例如 https://api.openai.com/v1/chat/completions"/>
        <TextBlock x:Name="OpenAiKeyLabel" Text="API 密钥" Margin="0,0,0,4"/><PasswordBox x:Name="OpenAiKeyBox" Padding="9" Margin="0,0,0,8"/>
        <TextBlock x:Name="ModelLabel" Text="模型名称（填写你的服务支持的模型）" Margin="0,0,0,4"/><TextBox x:Name="ModelBox" Margin="0,0,0,16"/>
        <TextBlock x:Name="PlannedProvidersHelp" Text="已为 Microsoft Translator 与 Papago 保留位置。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/>
        <TextBlock x:Name="SecurityHelp" Text="密钥由 Windows 按当前用户加密后保存在程序旁的 data 目录；日志只记录耗时和状态，不记录原文或译文。更换电脑或 Windows 用户后需重新填写密钥。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
